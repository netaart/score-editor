{
  "name": "score-editor-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:pack": "node scripts/check-pack.mjs",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@neta-art/score-dialect-song2": "workspace:*",
    "@neta-art/score-editor": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.19",
    "esbuild": "0.28.2",
    "tsdown": "0.15.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
